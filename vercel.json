{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter site build",
  "outputDirectory": "apps/site/dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [{ "source": "/p/(.*)", "destination": "/api/share" }]
}
