        {
          "color": "#c5ccd4",
          "position": 0.8571
        },
        {
          "color": "#cdd3da",
          "position": 0.8571
        },
        {
          "color": "#cdd3da",
          "position": 1
        }
      ],
      "$description": "the classic grouped-table pinstripe, dark edition",
      "$extensions": {
        "com.3gs.css": "--gs-pinstripe-bg",
        "com.3gs.angle": 90,
        "com.3gs.cssValue": "repeating-linear-gradient(to right, #c5ccd4 0px, #c5ccd4 6px, #cdd3da 6px, #cdd3da 7px)",
        "com.3gs.repeating": true,
        "com.3gs.period": "7px"
      }
    }
  },
