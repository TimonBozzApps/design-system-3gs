{
  "$description": "3GS UI — light theme (classic iOS 3): the dark set with theme-light.css laid over it, var() references re-resolved against the merged set.",
  "$extensions": {
    "com.3gs": {
      "name": "3GS UI design tokens",
      "version": "0.0.0",
      "prefix": "--gs-",
      "source": [
        "packages/ui/src/tokens/tokens.css",
        "packages/ui/src/tokens/theme-light.css"
      ],
      "generator": "scripts/export-tokens.mjs",
      "theme": "light"
    }
  },
  "font": {
    "default": {
      "$type": "fontFamily",
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$extensions": {
        "com.3gs.css": "--gs-font"
      }
    },
    "size-xs": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "tab-bar labels, badges",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-xs"
      }
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "13px",
      "$description": "secondary / footer text",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-sm"
      }
    },
    "size-md": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "detail text, back buttons",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-md"
      }
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "17px",
      "$description": "cell titles, inputs, buttons",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-lg"
      }
    },
    "size-xl": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "nav-bar titles",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-xl"
      }
    }
  },
  "line": {
    "height": {
      "$type": "number",
      "$value": 1.2,
      "$extensions": {
        "com.3gs.css": "--gs-line-height"
      }
    }
  },
  "black": {
    "$type": "color",
    "$value": "#000000",
    "$extensions": {
      "com.3gs.css": "--gs-black"
    }
  },
  "white": {
    "$type": "color",
    "$value": "#ffffff",
    "$extensions": {
      "com.3gs.css": "--gs-white"
    }
  },
  "gray": {
    "100": {
      "$type": "color",
      "$value": "#f2f2f5",
      "$extensions": {
        "com.3gs.css": "--gs-gray-100"
      }
    },
    "200": {
      "$type": "color",
      "$value": "#d9d9de",
      "$extensions": {
        "com.3gs.css": "--gs-gray-200"
      }
    },
    "300": {
      "$type": "color",
      "$value": "#b8b8bd",
      "$extensions": {
        "com.3gs.css": "--gs-gray-300"
      }
    },
    "400": {
      "$type": "color",
      "$value": "#8e8e93",
      "$extensions": {
        "com.3gs.css": "--gs-gray-400"
      }
    },
    "500": {
      "$type": "color",
      "$value": "#58585c",
