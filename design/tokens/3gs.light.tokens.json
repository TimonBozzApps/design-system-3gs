      "$type": "color",
      "$value": "#2a2a2d",
      "$extensions": {
        "com.3gs.css": "--gs-gray-700"
      }
    },
    "800": {
      "$type": "color",
      "$value": "#1c1c1e",
      "$extensions": {
        "com.3gs.css": "--gs-gray-800"
      }
    },
    "900": {
      "$type": "color",
      "$value": "#131315",
      "$extensions": {
        "com.3gs.css": "--gs-gray-900"
      }
    }
  },
  "text": {
    "default": {
      "$type": "color",
      "$value": "#000000",
      "$extensions": {
        "com.3gs.css": "--gs-text"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#4c566c",
      "$extensions": {
        "com.3gs.css": "--gs-text-secondary"
      }
    },
    "tertiary": {
      "$type": "color",
      "$value": "#8e8e93",
      "$extensions": {
        "com.3gs.css": "--gs-text-tertiary"
      }
    },
    "link": {
      "$type": "color",
      "$value": "#385487",
      "$extensions": {
        "com.3gs.css": "--gs-text-link"
      }
    },
    "on-blue": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-blue"
      }
    },
    "disabled": {
      "$type": "color",
      "$value": "#00000059",
      "$extensions": {
        "com.3gs.css": "--gs-text-disabled"
      }
    },
    "shadow-dark": {
      "$type": "shadow",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "white text on dark gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-dark",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.7)"
      }
    },
    "shadow-light": {
      "$type": "shadow",
      "$value": {
        "color": "#ffffff99",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "dark text on light gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-light",
        "com.3gs.cssValue": "0 1px 0 rgba(255, 255, 255, 0.6)"
      }
    },
    "on-neutral": {
      "$type": "color",
      "$value": "#1c1c1e",
      "$description": "text on the neutral gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-neutral"
      }
    },
    "shadow-on-neutral": {
      "$type": "shadow",
      "$value": {
        "color": "#ffffffcc",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-on-neutral",
        "com.3gs.cssValue": "0 1px 0 rgba(255, 255, 255, 0.8)"
      }
    },
    "on-bar": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "bar titles / bar-button labels",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-bar"
      }
    },
    "shadow-on-bar": {
      "$type": "shadow",
      "$value": {
        "color": "#00000066",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-on-bar",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.4)"
      }
    },
    "emboss": {
      "$type": "shadow",
      "$value": {
        "color": "#ffffffbf",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "text sitting on --gs-surface (cells, labels)",
      "$extensions": {
        "com.3gs.css": "--gs-text-emboss",
        "com.3gs.cssValue": "0 1px 0 rgba(255, 255, 255, 0.75)"
      }
    }
