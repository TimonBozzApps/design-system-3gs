{
  "$description": "3GS UI — dark theme (default): black glass, --gs-* tokens from tokens.css.",
  "$extensions": {
    "com.3gs": {
      "name": "3GS UI design tokens",
      "version": "0.0.0",
      "prefix": "--gs-",
      "source": [
        "packages/ui/src/tokens/tokens.css"
      ],
      "generator": "scripts/export-tokens.mjs",
      "theme": "dark"
    }
  },
  "font": {
    "default": {
      "$type": "fontFamily",
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$extensions": {
        "com.3gs.css": "--gs-font"
      }
    },
    "size-xs": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "tab-bar labels, badges",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-xs"
      }
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "13px",
      "$description": "secondary / footer text",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-sm"
      }
    },
    "size-md": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "detail text, back buttons",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-md"
      }
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "17px",
      "$description": "cell titles, inputs, buttons",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-lg"
      }
    },
    "size-xl": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "nav-bar titles",
      "$extensions": {
        "com.3gs.css": "--gs-font-size-xl"
      }
    }
  },
  "line": {
    "height": {
      "$type": "number",
      "$value": 1.2,
      "$extensions": {
        "com.3gs.css": "--gs-line-height"
      }
    }
  },
  "black": {
    "$type": "color",
    "$value": "#000000",
    "$extensions": {
      "com.3gs.css": "--gs-black"
    }
  },
  "white": {
    "$type": "color",
    "$value": "#ffffff",
    "$extensions": {
      "com.3gs.css": "--gs-white"
    }
  },
  "gray": {
    "100": {
      "$type": "color",
      "$value": "#f2f2f5",
      "$extensions": {
        "com.3gs.css": "--gs-gray-100"
      }
    },
    "200": {
      "$type": "color",
      "$value": "#d9d9de",
      "$extensions": {
        "com.3gs.css": "--gs-gray-200"
      }
    },
    "300": {
      "$type": "color",
      "$value": "#b8b8bd",
      "$extensions": {
        "com.3gs.css": "--gs-gray-300"
      }
    },
    "400": {
      "$type": "color",
      "$value": "#8e8e93",
      "$extensions": {
        "com.3gs.css": "--gs-gray-400"
      }
    },
    "500": {
      "$type": "color",
      "$value": "#58585c",
      "$extensions": {
        "com.3gs.css": "--gs-gray-500"
      }
    },
    "600": {
      "$type": "color",
      "$value": "#3a3a3e",
      "$extensions": {
        "com.3gs.css": "--gs-gray-600"
      }
    },
    "700": {
      "$type": "color",
      "$value": "#2a2a2d",
      "$extensions": {
        "com.3gs.css": "--gs-gray-700"
      }
    },
    "800": {
      "$type": "color",
      "$value": "#1c1c1e",
      "$extensions": {
        "com.3gs.css": "--gs-gray-800"
      }
    },
    "900": {
      "$type": "color",
      "$value": "#131315",
      "$extensions": {
        "com.3gs.css": "--gs-gray-900"
      }
    }
  },
  "text": {
    "default": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.3gs.css": "--gs-text"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#a1a1a6",
      "$extensions": {
        "com.3gs.css": "--gs-text-secondary"
      }
    },
    "tertiary": {
      "$type": "color",
      "$value": "#6f6f75",
      "$extensions": {
        "com.3gs.css": "--gs-text-tertiary"
      }
    },
    "link": {
      "$type": "color",
      "$value": "#8cb6ff",
      "$extensions": {
        "com.3gs.css": "--gs-text-link"
      }
    },
    "on-blue": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-blue"
      }
    },
    "disabled": {
      "$type": "color",
      "$value": "#ffffff59",
      "$extensions": {
        "com.3gs.css": "--gs-text-disabled"
      }
    },
    "shadow-dark": {
      "$type": "shadow",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "white text on dark gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-dark",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.7)"
      }
    },
    "shadow-light": {
      "$type": "shadow",
      "$value": {
        "color": "#ffffff99",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "dark text on light gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-light",
        "com.3gs.cssValue": "0 1px 0 rgba(255, 255, 255, 0.6)"
      }
    },
    "on-neutral": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "text on the neutral gel",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-neutral"
      }
    },
    "shadow-on-neutral": {
      "$type": "shadow",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-on-neutral",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.7)",
        "com.3gs.alias": "--gs-text-shadow-dark"
      }
    },
    "on-bar": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "bar titles / bar-button labels",
      "$extensions": {
        "com.3gs.css": "--gs-text-on-bar"
      }
    },
    "shadow-on-bar": {
      "$type": "shadow",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$extensions": {
        "com.3gs.css": "--gs-text-shadow-on-bar",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.7)",
        "com.3gs.alias": "--gs-text-shadow-dark"
      }
    },
    "emboss": {
      "$type": "shadow",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "-1px",
        "blur": "0px",
        "spread": "0px",
        "inset": false
      },
      "$description": "text sitting on --gs-surface (cells, labels)",
      "$extensions": {
        "com.3gs.css": "--gs-text-emboss",
        "com.3gs.cssValue": "0 -1px 0 rgba(0, 0, 0, 0.7)",
        "com.3gs.alias": "--gs-text-shadow-dark"
      }
    }
  },
  "blue": {
    "100": {
      "$type": "color",
      "$value": "#9ec4ff",
      "$extensions": {
        "com.3gs.css": "--gs-blue-100"
