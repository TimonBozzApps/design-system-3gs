    "700": {
      "$type": "color",
      "$value": "#1d4fa4",
      "$extensions": {
        "com.3gs.css": "--gs-blue-700"
      }
    },
    "900": {
      "$type": "color",
      "$value": "#12376f",
      "$extensions": {
        "com.3gs.css": "--gs-blue-900"
      }
    }
  },
  "red": {
    "300": {
      "$type": "color",
      "$value": "#ff7b76",
      "$extensions": {
        "com.3gs.css": "--gs-red-300"
      }
    },
    "500": {
      "$type": "color",
      "$value": "#d8332e",
      "$extensions": {
        "com.3gs.css": "--gs-red-500"
      }
    },
    "700": {
      "$type": "color",
      "$value": "#9c1712",
      "$extensions": {
        "com.3gs.css": "--gs-red-700"
      }
    }
  },
  "green": {
    "500": {
      "$type": "color",
      "$value": "#4cd964",
      "$extensions": {
        "com.3gs.css": "--gs-green-500"
      }
    }
  },
  "screen": {
    "bg": {
      "$type": "color",
      "$value": "#000000",
      "$extensions": {
        "com.3gs.css": "--gs-screen-bg"
      }
    }
  },
  "pinstripe": {
    "bg": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#151517",
          "position": 0
        },
        {
          "color": "#151517",
          "position": 0.8571
        },
        {
          "color": "#1b1b1e",
          "position": 0.8571
        },
        {
          "color": "#1b1b1e",
          "position": 1
        }
      ],
      "$description": "the classic grouped-table pinstripe, dark edition",
      "$extensions": {
        "com.3gs.css": "--gs-pinstripe-bg",
        "com.3gs.angle": 90,
        "com.3gs.cssValue": "repeating-linear-gradient(to right, #151517 0px, #151517 6px, #1b1b1e 6px, #1b1b1e 7px)",
        "com.3gs.repeating": true,
        "com.3gs.period": "7px"
      }
    }
  },
  "surface": {
    "default": {
      "$type": "color",
      "$value": "#2c2c2f",
      "$extensions": {
        "com.3gs.css": "--gs-surface"
      }
    },
    "raised": {
      "$type": "color",
      "$value": "#38383c",
      "$extensions": {
        "com.3gs.css": "--gs-surface-raised"
      }
    },
    "sunken": {
      "$type": "color",
      "$value": "#1a1a1c",
      "$extensions": {
        "com.3gs.css": "--gs-surface-sunken"
      }
    },
    "gloss": {
      "$type": "string",
      "$value": "none",
      "$description": "extra highlight over cells (light: subtle)",
      "$extensions": {
        "com.3gs.css": "--gs-surface-gloss"
      }
    }
  },
  "separator": {
    "default": {
      "$type": "color",
      "$value": "#000000d9",
      "$extensions": {
        "com.3gs.css": "--gs-separator"
      }
    },
    "light": {
      "$type": "color",
      "$value": "#ffffff17",
      "$extensions": {
        "com.3gs.css": "--gs-separator-light"
      }
    }
  },
  "gloss": {
    "default": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#ffffff4d",
          "position": 0
        },
        {
          "color": "#ffffff1f",
          "position": 0.5
        },
        {
          "color": "#ffffff00",
          "position": 0.505
        },
        {
          "color": "#ffffff00",
          "position": 1
        }
      ],
      "$description": "glass highlight: hard split at 50% = the signature iOS 3 shine",
      "$extensions": {
        "com.3gs.css": "--gs-gloss",
        "com.3gs.angle": 180,
        "com.3gs.cssValue": "linear-gradient(to bottom, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.00) 50.5%, rgba(255, 255, 255, 0.00) 100%)"
      }
    },
    "soft": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#ffffff2e",
          "position": 0
        },
        {
          "color": "#ffffff0f",
          "position": 0.5
        },
        {
          "color": "#ffffff00",
          "position": 0.51
        },
        {
          "color": "#ffffff00",
          "position": 1
        }
      ],
      "$extensions": {
        "com.3gs.css": "--gs-gloss-soft",
        "com.3gs.angle": 180,
        "com.3gs.cssValue": "linear-gradient(to bottom, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.06) 50%, rgba(255, 255, 255, 0.00) 51%, rgba(255, 255, 255, 0.00) 100%)"
      }
    }
  },
  "gradient": {
