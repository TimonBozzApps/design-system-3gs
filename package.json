{
  "name": "design-system-3gs",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "props": "pnpm --filter site props",
    "preview": "pnpm --filter site preview",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "pack:check": "pnpm --filter @3gs/ui build && cd packages/ui && pnpm pack --pack-destination ../../.packs && cd ../.. && tar -tzf .packs/*.tgz | sort",
    "design:export": "node scripts/export-tokens.mjs && node scripts/figma-sheet.mjs",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.6.0"
  }
}
