# PostHog — both values are OPTIONAL. Leave unset and analytics stays off.
# The project token (phc_…) is PostHog's public, write-only browser key; it is
# meant to ship in the bundle. Never put a personal API key (phx_…) here.
VITE_POSTHOG_KEY=
# EU cloud is the default; use https://us.i.posthog.com for US cloud.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
